# ─── Integration-test environment (template) ─────────────────
# Copy to .env.test and fill in. .env.test is git-ignored and must NEVER
# contain production keys — use a dedicated test project or, at minimum,
# keys you are prepared to rotate. CI reads these from repository secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
NODE_ENV=test
