{
  "name": "vitallens-server",
  "version": "1.0.0",
  "description": "VitalLens Product Scanner API \u2014 barcode lookup, OCR parsing, and health scoring",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --import ./instrument.js server.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:food": "node evals/food-scan-eval.js"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/redis": "^1.38.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.2.0",
    "jose": "^6.2.12",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.6"
  }
}
