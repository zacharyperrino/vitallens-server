# ─── VitalLens API — environment template ─────────────────────
# Copy to .env and fill in. Never commit .env — and never put REAL
# values in this template file (it is committed).

# Runtime
NODE_ENV=development            # set to "production" on deploy
PORT=3001
FRONTEND_URL=http://localhost:3000   # comma-separated allow-list for CORS
INTERNAL_API_BASE=               # optional; defaults to http://localhost:$PORT

# Supabase (project: vitallens)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only; bypasses RLS — guard carefully
DATABASE_URL=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_API_KEY=            # OCR (Vision API)

# Hard AI spend ceilings (USD per calendar month) — see services/spend-guard.js
MAX_USER_MONTHLY_USD=5
MAX_USER_MONTHLY_USD_PREMIUM=50
MAX_GLOBAL_MONTHLY_USD=250

# Nutrition lookups
USDA_API_KEY=                    # free key from api.data.gov; DEMO_KEY fallback

# Redis (Upstash REST — used for the context snapshot cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Push notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Wearables (optional)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=

# OAuth state signing (Oura). Any long random string; falls back to a hash of
# the service-role key if unset.
OAUTH_STATE_SECRET=
# Public origin of THIS API, used to build OAuth redirect URIs.
API_PUBLIC_URL=http://localhost:3001
OURA_REDIRECT_URI=                 # optional override; default = $API_PUBLIC_URL/api/oura/callback
# Optional: mounts the practitioner-sharing and genomics routes (off by default).
ENABLE_EXPERIMENTAL_ROUTES=false
